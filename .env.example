# Copy this file to .env and fill in real values. NEVER commit .env.
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요. .env는 절대 커밋하지 않습니다.

# PostgreSQL 접속 URL (scripts/setup_db.ps1 실행 시 자동 생성 가능)
# 형식: postgresql+psycopg://<user>:<password>@localhost:5432/<database>
DATABASE_URL=

# OpenDART API Key (https://opendart.fss.or.kr/ 에서 무료 발급)
DART_API_KEY=

# KRX Open API Key (https://openapi.krx.co.kr/ 에서 신청)
KRX_API_KEY=

# 뉴스 검색 (Claude CLI 웹검색, AI_PROVIDER=claude_cli일 때) — 가벼운 모델 사용, 하루 검색 횟수 상한
NEWS_SEARCH_MODEL=sonnet
NEWS_DAILY_SEARCH_LIMIT=40

# AI Provider: claude_cli | anthropic | none
AI_PROVIDER=claude_cli
# claude_cli 모드 모델 별칭 (opus | sonnet | haiku)
CLAUDE_CLI_MODEL=opus
# API 기반 모델 사용 시 (AI_PROVIDER=anthropic)
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# dart-market-monitor DB (읽기 전용 계정, scripts/setup_db.ps1 이 자동 생성)
DART_MONITOR_DATABASE_URL=
# 같은 API 키를 공유하는 다른 서비스 몫을 남기기 위한 ValueScope 일일 호출 상한
DART_DAILY_CALL_LIMIT=3000
KRX_DAILY_CALL_LIMIT=1000

# 로컬 웹 서비스 (localhost 전용)
APP_HOST=127.0.0.1
APP_PORT=8000

# PDF 출력용 브라우저 경로 (비우면 Edge/Chrome 기본 설치 경로에서 자동 탐색)
PDF_BROWSER_PATH=
