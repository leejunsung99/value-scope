# Copy this file to .env and fill in real values. NEVER commit .env.
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요. .env는 절대 커밋하지 않습니다.

# PostgreSQL 접속 URL (scripts/setup_db.ps1 실행 시 자동 생성 가능)
# 형식: postgresql+psycopg://<user>:<password>@localhost:5432/<database>
DATABASE_URL=

# OpenDART API Key (https://opendart.fss.or.kr/ 에서 무료 발급)
DART_API_KEY=

# KRX Open API Key (https://openapi.krx.co.kr/ 에서 신청)
KRX_API_KEY=

# 뉴스 검색 API Key (선택)
NEWS_API_KEY=

# AI Provider: anthropic | claude_cli | none
AI_PROVIDER=none
# API 기반 모델 사용 시 (AI_PROVIDER=anthropic)
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# 로컬 웹 서비스 (localhost 전용)
APP_HOST=127.0.0.1
APP_PORT=8000
